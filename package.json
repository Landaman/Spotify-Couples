{
	"name": "spotify-couples",
	"version": "0.0.0",
	"private": true,
	"packageManager": "bun@1.3.13",
	"scripts": {
		"format:svelte": "prettier --write .",
		"format:supabase": "bun scripts/format-supabase-sql.ts",
		"gen:supabase": "supabase gen types --local > supabase/schema.d.ts && prettier --write supabase/schema.d.ts && eslint --fix supabase/schema.d.ts",
		"gen:svelte": "svelte-kit sync",
		"check:svelte": "svelte-check --tsconfig ./tsconfig.json",
		"check:supabase": "supabase db lint --local --fail-on warning",
		"lint:svelte": "eslint --max-warnings 0 ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@postgres-language-server/cli": "0.28.1",
		"@sveltejs/adapter-vercel": "7.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "1.4.2",
		"@types/eslint-config-prettier": "^6.11.3",
		"@types/eslint__js": "^9.14.0",
		"eslint": "10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"eslint-plugin-tailwindcss": "^4.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"pg-formatter": "^2.0.8",
		"prettier": "^3.9.10",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"sql-formatter": "^15.9.0",
		"supabase": "2.120.0",
		"sv": "^1.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "4.7.6",
		"svelte-eslint-parser": "^1.9.0",
		"tailwindcss": "^4.3.3",
		"turbo": "2.11.7",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.0",
		"typescript-eslint": "8.71.1",
		"typescript-svelte-plugin": "^0.3.52",
		"vite": "^8.3.4"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#supabase/*": "./supabase/*"
	},
	"type": "module",
	"dependencies": {
		"@lucide/svelte": "1.55.0",
		"@spotify/web-api-ts-sdk": "^1.2.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "2.117.3",
		"arctic": "^3.7.0",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"lucia": "^3.2.2",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"simplex-noise": "^4.0.3",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"vaul-svelte": "^0.3.2"
	},
	"trustedDependencies": [
		"@sveltejs/kit",
		"esbuild",
		"pg-formatter",
		"protobufjs",
		"re2",
		"sharp",
		"supabase"
	]
