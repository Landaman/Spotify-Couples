{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"format:svelte": {
			"cache": false,
			"inputs": ["$TURBO_DEFAULT$", "!supabase/**", "!README.md", "!LICENSE", "!.github/**"]
		},
		"format:supabase": {
			"cache": false,
			"inputs": [
				"supabase/schemas/**/*.sql",
				".sql-formatter.json",
				".pg_format",
				"scripts/format-supabase-sql.ts"
			]
		},
		"format": {
			"dependsOn": ["format:svelte", "format:supabase"],
			"inputs": []
		},
		"gen:supabase": {
			"inputs": ["supabase/schemas/**/*.sql"],
			"outputs": ["supabase/schema.d.ts"]
		},
		"gen:svelte": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"!supabase/**",
				"!scripts/**",
				"!eslint.config.js",
				"!postgres-language-server.jsonc",
				"!.pg_format",
				"!.sql-formatter.json",
				"!README.md",
				"!LICENSE",
				"!.github/**"
			],
			"outputs": [".svelte-kit/**"]
		},
		"gen": {
			"dependsOn": ["gen:svelte", "gen:supabase"],
			"inputs": []
		},
		"check:svelte": {
			"dependsOn": ["gen:svelte", "gen:supabase"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!supabase/**",
				"!eslint.config.js",
				"!postgres-language-server.jsonc",
				"!README.md",
				"!LICENSE",
				"!.github/**"
			]
		},
		"check:supabase": {
			"inputs": ["supabase/**/*.sql", "supabase/config.toml", "postgres-language-server.jsonc"]
		},
		"check": {
			"dependsOn": ["check:svelte", "check:supabase"],
			"inputs": []
		},
		"lint:svelte": {
			"dependsOn": ["gen:svelte", "gen:supabase"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!supabase/**",
				"!postgres-language-server.jsonc",
				"!README.md",
				"!LICENSE",
				"!.github/**"
			]
		},
		"lint": {
			"dependsOn": ["lint:svelte"],
			"inputs": []
		}
	}
}
